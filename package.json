{
  "name": "real-fast-write",
  "productName": "rf-write",
  "version": "26.10.0-dev.0",
  "description": "Calm Markdown editor that looks like the real-fast-document PDF while you type.",
  "license": "MIT",
  "author": "jcmx9",
  "homepage": "https://github.com/jcmx9/real-fast-write",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcmx9/real-fast-write.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/markdown": "^1.8.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "electron": "^44.7.2",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
